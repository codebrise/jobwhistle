# Jobwhistle API Environment Variables
APP_ENV=production
APP_URL=https://jobwhistle.codebrise.com
WEB_ORIGIN=https://jobwhistle.codebrise.com

# Cloudflare D1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=

# Resend Transactional Email (Free Tier)
